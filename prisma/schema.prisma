generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Recipe {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  title       String
  summary     String
  courseType  String
  portions    Int

  ingredients         String
  steps               String
  flavorAnalysis      String
  chefRecommendations String

  protein    String?
  starchBase String?
  vegetable  String?
  sauce      String?
  garnish    String?
  flavorGoal String
}